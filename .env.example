# GROQ_API_KEY: Required for Groq Audio Analysis Engine (Whisper speech-to-text & music analysis).
# Free tier model: whisper-large-v3 (active, not deprecated).
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_AUDIO_MODEL="whisper-large-v3"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE (Optional for Cloud Mode; when omitted, HUMMIT runs in Local Development Mode with IndexedDB)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
